[statement]
Format 1.0 records in a global header before a regular member: bsdtar fails,
Go reads a file of the stored data, GNU tar applies them. Refused at both
levels in every mode.

[archive]
global GNU.sparse.major=1 GNU.sparse.minor=0 GNU.sparse.name=sp GNU.sparse.realsize=2048
header name=GNUSparseFile.0/sp size=1024
data "1\n1024\n512\n""\0"*501"S"*512
header name=tail
data "hello\n"
end

