[statement]
A NUL in `GNU.sparse.name`: GNU tar and bsdtar cut the name there, Python
and Go keep it. Refused at both levels.

[archive]
pax GNU.sparse.major=1 GNU.sparse.minor=0 GNU.sparse.name="a\0b" GNU.sparse.realsize=2048
header name=GNUSparseFile.0/sp typeflag=0 size=1024
data "2\n1024\n512\n2048\n0\n""\0"*494"S"*512
header name=tail
data "hello\n"
end

[verdict]
strict: refused Sparse(PaxForm) at 1024
compatible: refused Sparse(Name) at 1024

[gnu-tar 1.35]
member listed=- path=a size=2048 mode=0o644 data="\0"*1024"S"*512"\0"*512
member listed=- path=tail size=6 mode=0o644 data="hello\n"
exit 0

[bsdtar 3.8.11]
member listed=- path=a size=2048 mode=0o644
member listed=- path=tail size=6 mode=0o644
exit 0

[python 3.12.3]
member type=0 path="a\0b" size=2048 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="\0"*1024"S"*512"\0"*512
member type=0 path=tail size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
member type=0 path="a\0b" size=2048 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="\0"*1024"S"*512"\0"*512
member type=0 path=tail size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok
