[statement]
A sparse file in GNU's pax format 1.0 whose POSIX header ends in star's
trailer, its two times each ending in a NUL. Every reader lists the file
and the member after it. ferrotape refuses the archive, as it refuses a
pax sparse member under star's trailer whatever its times.

[archive]
pax GNU.sparse.major=1 GNU.sparse.minor=0 GNU.sparse.name=sp GNU.sparse.realsize=2048
header name=GNUSparseFile.0/sp size=1024 @476="00000001750\000000003720\0" @508="tar\0"
data "1\n1536\n512\n""\0"*501"S"*512
header name=tail
data "hello\n"
end

[verdict]
strict: refused Sparse(PaxForm) at 1024
compatible: refused Sparse(StarTrailer) at 1024

[gnu-tar 1.35]
member listed=- path=sp size=2048 mode=0o644 data="\0"*1536"S"*512
member listed=- path=tail size=6 mode=0o644 data="hello\n"
exit 0

[bsdtar 3.8.11]
member listed=- path=sp size=2048 mode=0o644
member listed=- path=tail size=6 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=sp size=2048 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="\0"*1536"S"*512
member type=0 path=tail size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

