[statement]
A format 1.0 map number of 20 digits, leading zeros included: GNU tar fails
("numeric overflow"), the others read it. GNU tar reads 19 anywhere in a
map. Refused at both levels.

[archive]
pax GNU.sparse.major=1 GNU.sparse.minor=0 GNU.sparse.name=sp GNU.sparse.realsize=2048
header name=GNUSparseFile.0/sp typeflag=0 size=1024
data "2\n""0"*16"1024\n512\n2048\n0\n""\0"*478"S"*512
header name=tail
data "hello\n"
end

[verdict]
strict: refused Sparse(PaxForm) at 1024
compatible: refused Sparse(Number) at 1024

[gnu-tar 1.35]
member listed=- path=sp size=2048 mode=0o644 data=""
member listed=- path=tail size=6 mode=0o644 data="hello\n"
warning "tar: sp: numeric overflow in sparse archive member"
warning "tar: Exiting with failure status due to previous errors"
exit 2

