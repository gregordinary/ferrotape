[statement]
A sparse file in GNU's pax format 0.0 whose POSIX header ends in star's
trailer, with star's two times as star writes them. GNU tar lists the
file and nothing after it. bsdtar, Python and Go list the member after it
too. ferrotape refuses the archive.

[archive]
pax GNU.sparse.size=2048 GNU.sparse.numblocks=1 GNU.sparse.offset=1536 GNU.sparse.numbytes=512
header name=sp size=512 @476="00000001750 00000003720 " @508="tar\0"
data "S"*512
header name=tail
data "hello\n"
end

[verdict]
strict: refused Sparse(PaxForm) at 1024
compatible: refused Sparse(StarTrailer) at 1024

[gnu-tar 1.35]
member listed=- path=sp size=2048 mode=0o644 data=2048:93c6980a86b58203
warning "tar: A lone zero block at 8"
exit 0

[bsdtar 3.8.11]
member listed=- path=sp size=2048 mode=0o644
member listed=- path=tail size=6 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=sp size=2048 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="\0"*1536"S"*512
member type=0 path=tail size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
member type=0 path=sp size=2048 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="\0"*1536"S"*512
member type=0 path=tail size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
