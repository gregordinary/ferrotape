[statement]
A sparse file in GNU's pax format 1.0, as GNU tar writes it: records
naming the version, the file and its real size, the map at the start of the
member's data, a count and the regions' offsets and lengths, each on a line
and padded to a block. Compatible reads it; Strict refuses it, as Rust's
`tar` reads a file under the header's name holding the map and the regions.

[archive]
pax GNU.sparse.major=1 GNU.sparse.minor=0 GNU.sparse.name=sp GNU.sparse.realsize=2048
header name=GNUSparseFile.0/sp typeflag=0 size=1024
data "2\n1024\n512\n2048\n0\n""\0"*494"S"*512
header name=tail
data "hello\n"
end

[verdict]
strict: refused Sparse(PaxForm) at 1024
compatible: read

[gnu-tar 1.35]
member listed=- path=sp size=2048 mode=0o644 data="\0"*1024"S"*512"\0"*512
member listed=- path=tail size=6 mode=0o644 data="hello\n"
exit 0

[bsdtar 3.8.11]
member listed=- path=sp size=2048 mode=0o644
member listed=- path=tail size=6 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=sp size=2048 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="\0"*1024"S"*512"\0"*512
member type=0 path=tail size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
member type=0 path=sp size=2048 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="\0"*1024"S"*512"\0"*512
member type=0 path=tail size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok
