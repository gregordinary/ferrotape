[statement]
An old GNU header with its extension flag set and one region, then an
extension block with no slot used. GNU tar fails; the others read the
region. Refused at both levels.

[archive]
header name=sp typeflag=S magic=gnu size=512 @386="0"*7"2000\0""0"*7"1000\0""0"*7"4000\0""0"*11"\0"*49 @482="\x01" @483="0"*7"4000\0"
bytes "\0"*512
data "S"*512
header name=tail
data "hello\n"
end

[verdict]
all: refused Sparse(Extension) at 0

[gnu-tar 1.35]
member listed=- path=sp size=2048 mode=0o644 data="\0"*2048
member listed=- path=tail size=6 mode=0o644 data="hello\n"
warning "tar: Skipping to next header"
warning "tar: Exiting with failure status due to previous errors"
exit 2

