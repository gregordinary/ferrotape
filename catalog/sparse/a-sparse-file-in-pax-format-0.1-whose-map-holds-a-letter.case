[statement]
A format 0.1 map holding a letter. Each reader reads it otherwise, or not
at all. Refused at both levels.

[archive]
pax GNU.sparse.size=2048 GNU.sparse.numblocks=2 GNU.sparse.name=sp GNU.sparse.map=1024,5x2,2048,0
header name=GNUSparseFile.0/sp typeflag=0 size=512
data "S"*512
header name=tail
data "hello\n"
end

