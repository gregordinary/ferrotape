[statement]
A volume label declaring a size, its body holding two headers. ferrotape
refuses a volume label wherever it falls (see `a-volume-label`).

[archive]
header name=VOLUME typeflag=V magic=gnu size=1024
header name=sV1
header name=sV2
header name=tail
data "hello\n"
end

[verdict]
all: refused VolumeLabel at 0

[gnu-tar 1.35]
member listed=V path=VOLUME size=1024 mode=0o644 note="--Volume Header--"
member listed=- path=tail size=6 mode=0o644 data="hello\n"
exit 0

[bsdtar 3.8.11]
member listed=- path=tail size=6 mode=0o644
exit 0

[python 3.12.3]
member type=V path=VOLUME size=1024 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=1024:56af124286b27645
member type=0 path=tail size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
member type=V path=VOLUME size=1024 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=1024:56af124286b27645
member type=0 path=tail size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok
