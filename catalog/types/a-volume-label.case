[statement]
A GNU volume label (typeflag `V`). GNU tar lists it as a volume header and
bsdtar does not list it, and neither extracts anything for it; Python
extracts it as a file. ferrotape refuses a volume label wherever it falls.

[archive]
header name=VOLUME typeflag=V magic=gnu
header name=afterlabel
data "hello\n"
end

[verdict]
all: refused VolumeLabel at 0

[gnu-tar 1.35]
member listed=V path=VOLUME size=0 mode=0o644 note="--Volume Header--"
member listed=- path=afterlabel size=6 mode=0o644 data="hello\n"
exit 0

[bsdtar 3.8.11]
member listed=- path=afterlabel size=6 mode=0o644
exit 0

[python 3.12.3]
member type=V path=VOLUME size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=afterlabel size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
member type=V path=VOLUME size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=afterlabel size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok
