[statement]
A GNU long name, then a volume label, then a member. As with a pax header
(see `a-pax-header-before-a-volume-label`), the readers apply the name to
different members, and ferrotape refuses the volume label.

[archive]
longname renamed-long
header name=VOLUME typeflag=V magic=gnu
header name=victim
data "hello\n"
end

[verdict]
all: refused VolumeLabel at 1024

[gnu-tar 1.35]
member listed=V path=renamed-long size=0 mode=0o644 note="--Volume Header--"
member listed=- path=victim size=6 mode=0o644 data="hello\n"
exit 0

[bsdtar 3.8.11]
member listed=- path=renamed-long size=6 mode=0o644
exit 0

[python 3.12.3]
member type=V path=renamed-long size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=victim size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
member type=V path=renamed-long size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=victim size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok
