[statement]
A member of typeflag `8`, which GNU tar does not know, named with a
trailing slash, after a regular file. bsdtar lists a directory and GNU tar an
unknown type, which it extracts as a regular file. ferrotape refuses it.

[archive]
header name=a
data "x"
header name=n/ typeflag=8
header name=b
data "y"
end

[verdict]
all: refused UnknownTypeSlash at 1024

[gnu-tar 1.35]
member listed=- path=a size=1 mode=0o644 data="x"
member listed=? path=n/ size=0 mode=0o644 note="unknown file type '8'"
member listed=- path=b size=1 mode=0o644 data="y"
exit 0

[bsdtar 3.8.11]
member listed=- path=a size=1 mode=0o644
member listed=d path=n/ size=0 mode=0o644
member listed=- path=b size=1 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=a size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
member type=8 path=n/ size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=b size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="y"
ok

[go 1.27.0]
member type=0 path=a size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
member type=8 path=n/ size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=b size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="y"
