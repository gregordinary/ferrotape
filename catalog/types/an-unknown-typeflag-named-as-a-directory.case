[statement]
A member of typeflag `I`, which GNU tar does not know, named with a
trailing slash. bsdtar reads a directory; GNU tar and Python extract a
regular file. ferrotape refuses it.

[archive]
header name=i/ typeflag=I
header name=after
data "x"
end

[verdict]
all: refused UnknownTypeSlash at 0

[gnu-tar 1.35]
member listed=? path=i/ size=0 mode=0o644 note="unknown file type 'I'"
member listed=- path=after size=1 mode=0o644 data="x"
exit 0

[bsdtar 3.8.11]
member listed=d path=i/ size=0 mode=0o644
member listed=- path=after size=1 mode=0o644
exit 0

[python 3.12.3]
member type=I path=i/ size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=after size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok

[go 1.27.0]
member type=I path=i/ size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=after size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok
