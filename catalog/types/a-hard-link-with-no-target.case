[statement]
A hard link whose header names no target. GNU tar links it to `.`, its
substitute for an empty name; bsdtar, Python and Go read the empty name.
ferrotape refuses it.

[archive]
header name=f
data "x"
header name=h typeflag=1
end

[verdict]
all: refused HardLinkWithoutTarget at 1024

[gnu-tar 1.35]
member listed=- path=f size=1 mode=0o644 data="x"
member listed=h path=h link=. size=0 mode=0o644
warning "tar: Substituting `.' for empty hard link target"
exit 0

[bsdtar 3.8.11]
member listed=- path=f size=1 mode=0o644
member listed=h path=h link="" size=0 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=f size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
member type=1 path=h size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root
ok

[go 1.27.0]
member type=0 path=f size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
member type=1 path=h size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
ok
