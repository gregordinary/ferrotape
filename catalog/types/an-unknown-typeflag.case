[statement]
A typeflag no format defines is a regular file with data, as POSIX specifies
and every reader extracts it. GNU tar lists it as of an unknown type.

[archive]
header name=unknown typeflag=Z
data "zzzzz"
header name=after
data "hello\n"
end

[verdict]
all: read

[gnu-tar 1.35]
member listed=? path=unknown size=5 mode=0o644 data="zzzzz" note="unknown file type 'Z'"
member listed=- path=after size=6 mode=0o644 data="hello\n"
exit 0

[bsdtar 3.8.11]
member listed=- path=unknown size=5 mode=0o644
member listed=- path=after size=6 mode=0o644
exit 0

[python 3.12.3]
member type=Z path=unknown size=5 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="zzzzz"
member type=0 path=after size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
member type=Z path=unknown size=5 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="zzzzz"
member type=0 path=after size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok
