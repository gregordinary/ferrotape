member type=0 path=smuggled-d1 size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=smuggled-d2 size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
