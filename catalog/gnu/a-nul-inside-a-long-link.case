[statement]
A GNU long link holding a NUL before its last byte, read as such a long name
is (see `a-nul-inside-a-long-name`).

[archive]
longlink "tgt\0rest"
header name=lnk2 typeflag=2 linkname=x
end

[verdict]
strict: refused LongNameNul at 0
compatible: read

[gnu-tar 1.35]
member listed=l path=lnk2 link=tgt size=0 mode=0o644
exit 0

[bsdtar 3.8.11]
member listed=l path=lnk2 link=tgt size=0 mode=0o644
exit 0

[python 3.12.3]
member type=2 path=lnk2 link=tgt size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root
ok

[go 1.27.0]
member type=2 path=lnk2 link=tgt size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
ok
