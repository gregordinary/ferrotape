[statement]
A GNU long link of size zero before a hard link whose header names a
target. GNU tar links to `.`, Python to the empty name, and bsdtar and Go to
the header's target. ferrotape refuses it.

[archive]
header name=f
data "x"
header name=././@LongLink typeflag=K magic=gnu size=0
header name=h typeflag=1 linkname=f
end

[verdict]
all: refused EmptyMetadata at 1024

[gnu-tar 1.35]
member listed=- path=f size=1 mode=0o644 data="x"
member listed=h path=h link=. size=0 mode=0o644
warning "tar: Substituting `.' for empty hard link target"
exit 0

[bsdtar 3.8.11]
member listed=- path=f size=1 mode=0o644
member listed=h path=h link=f size=0 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=f size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
member type=1 path=h size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root
ok

[go 1.27.0]
member type=0 path=f size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
member type=1 path=h link=f size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
ok
