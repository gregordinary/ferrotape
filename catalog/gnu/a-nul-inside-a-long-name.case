[statement]
A GNU long name holding a NUL before its last byte. The reference readers cut
it at the first NUL, and some Rust readers strip one trailing NUL and keep the
rest. In Strict, ferrotape refuses it; in Compatible, it cuts the name at the
first NUL.

[archive]
longname "abc\0def"
header name=short
data "hello\n"
end

[verdict]
strict: refused LongNameNul at 0
compatible: read

[gnu-tar 1.35]
member listed=- path=abc size=6 mode=0o644 data="hello\n"
exit 0

[bsdtar 3.8.11]
member listed=- path=abc size=6 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=abc size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
member type=0 path=abc size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok
