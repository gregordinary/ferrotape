[statement]
A GNU long name whose size ends at its NUL, as GNU tar writes one. Every
reader reads `abc`, and so does ferrotape.

[archive]
header name=././@LongLink typeflag=L magic=gnu size=3
data "abc\0"
header name=hdr
data "x"
end

[verdict]
all: read

[gnu-tar 1.35]
member listed=- path=abc size=1 mode=0o644 data="x"
exit 0

[bsdtar 3.8.11]
member listed=- path=abc size=1 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=abc size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok

[go 1.27.0]
member type=0 path=abc size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok
