[statement]
A GNU long name whose last byte is its NUL, the padding after it holding
bytes that are not NUL. The name ends at the NUL for every reader, and
ferrotape reads it.

[archive]
header name=././@LongLink typeflag=L magic=gnu size=4
bytes "abc\0zzz"
bytes "\0"*505
header name=hdr
data "x"
end

[verdict]
all: read

[gnu-tar 1.35]
member listed=- path=abc size=1 mode=0o644 data="x"
exit 0

[bsdtar 3.8.11]
member listed=- path=abc size=1 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=abc size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok

[go 1.27.0]
member type=0 path=abc size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok
