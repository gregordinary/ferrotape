[statement]
A GNU long link holding only a NUL, before a symbolic link whose header
names a target. The value is empty, and the readers split as they do over a
long link of size zero; ferrotape refuses it.

[archive]
header name=././@LongLink typeflag=K magic=gnu size=1
data "\0"
header name=lnk typeflag=2 linkname=hdrlink
end

[verdict]
all: refused EmptyMetadata at 0

[gnu-tar 1.35]
member listed=l path=lnk link="" size=0 mode=0o644
exit 0

[bsdtar 3.8.11]
member listed=l path=lnk link=hdrlink size=0 mode=0o644
exit 0

[python 3.12.3]
member type=2 path=lnk size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root
ok

[go 1.27.0]
member type=2 path=lnk link=hdrlink size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
ok
