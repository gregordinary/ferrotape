[statement]
A GNU long link of size zero before a regular file. bsdtar lists the file
as a link to an empty name, and the others as a file. ferrotape refuses an
empty long link before any member.

[archive]
header name=././@LongLink typeflag=K magic=gnu size=0
header name=a
data "x"
end

[verdict]
all: refused EmptyMetadata at 0

[gnu-tar 1.35]
member listed=- path=a size=1 mode=0o644 data="x"
exit 0

[bsdtar 3.8.11]
member listed=- path=a link="" size=1 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=a size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok

[go 1.27.0]
member type=0 path=a size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok
