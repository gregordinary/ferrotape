[statement]
A member's own pax header with an empty `uid`, under a global `uid`. GNU tar
reports a malformed header and keeps the global value, bsdtar and Python read
0, and Go the header's field. ferrotape refuses an empty value of a keyword it
applies.

[archive]
global uid=1234
pax uid=""
header name=a uid=7
data "hello\n"
header name=b uid=7
data "hello\n"
end

[verdict]
refuse: refused GlobalRecord at 0
apply: refused PaxValue at 1024
defer: refused PaxValue at 1024

[gnu-tar 1.35]
member listed=- path=a size=6 mode=0o644 data="hello\n"
member listed=- path=b size=6 mode=0o644 data="hello\n"
warning "tar: Malformed extended header: invalid uid="
warning "tar: Exiting with failure status due to previous errors"
exit 2

[bsdtar 3.8.11]
warning "bsdtar: Unsupported pax global extended header attribute 'uid'"
warning "bsdtar: Error exit delayed from previous errors"
exit 1

[python 3.12.3]
member type=0 path=a size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
member type=0 path=b size=6 mode=0o644 mtime=0 uid=1234 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
member type=g path=PaxHeader size=0 mode=0o0 mtime=-62135596800 uid=0 gid=0 uname="" gname="" data=""
member type=0 path=a size=6 mode=0o644 mtime=0 uid=7 gid=0 uname=root gname=root data="hello\n"
member type=0 path=b size=6 mode=0o644 mtime=0 uid=7 gid=0 uname=root gname=root data="hello\n"
ok
