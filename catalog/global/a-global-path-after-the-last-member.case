[statement]
A global header setting `path` after the last member. Every reader lists
the one member; bsdtar then reports the header and exits with an error.

[archive]
header name=a
data "x"
global path=renamed
end

[verdict]
refuse: refused GlobalRecord at 1024
apply: read
defer: read

[gnu-tar 1.35]
member listed=- path=a size=1 mode=0o644 data="x"
exit 0

[bsdtar 3.8.11]
member listed=- path=a size=1 mode=0o644
warning "bsdtar: Unsupported pax global extended header attribute 'path'"
warning "bsdtar: Error exit delayed from previous errors"
exit 1

[python 3.12.3]
member type=0 path=a size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
error "ReadError: end of file header"

[go 1.27.0]
member type=0 path=a size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
member type=g path=renamed size=0 mode=0o0 mtime=-62135596800 uid=0 gid=0 uname="" gname="" data=""
ok
