[statement]
A global header carrying an extended attribute. GNU tar does not apply it,
Python copies it into each member's records, and bsdtar and Go apply nothing.
A vendor keyword in a global header is refused in Apply; in Defer it reaches
the caller.

[archive]
global SCHILY.xattr.user.k=v
header name=a
data "hello\n"
end

[verdict]
refuse: refused GlobalRecord at 0
apply: refused GlobalRecord at 0
defer: read

[gnu-tar 1.35]
member listed=- path=a size=6 mode=0o644 data="hello\n"
exit 0

[bsdtar 3.8.11]
warning "bsdtar: Unsupported pax global extended header attribute 'SCHILY.xattr.user.k'"
warning "bsdtar: Error exit delayed from previous errors"
exit 1

[python 3.12.3]
member type=0 path=a size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
member type=g path=PaxHeader size=0 mode=0o0 mtime=-62135596800 uid=0 gid=0 uname="" gname="" data=""
member type=0 path=a size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok
