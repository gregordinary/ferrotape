[statement]
Two global headers holding only comments, back to back. bsdtar refuses two
global headers with no member between them, whatever they hold, and the
others read the member. ferrotape refuses the second global header in every
mode.

[archive]
global comment=one
global comment=two
header name=a
data "hello\n"
end

[verdict]
all: refused RepeatedMetadata at 1024

[gnu-tar 1.35]
member listed=- path=a size=6 mode=0o644 data="hello\n"
exit 0

[bsdtar 3.8.11]
warning "bsdtar: Redundant 'g' header"
warning "bsdtar: Error exit delayed from previous errors"
exit 1

[python 3.12.3]
member type=0 path=a size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
member type=g path=PaxHeader size=0 mode=0o0 mtime=-62135596800 uid=0 gid=0 uname="" gname="" data=""
member type=g path=PaxHeader size=0 mode=0o0 mtime=-62135596800 uid=0 gid=0 uname="" gname="" data=""
member type=0 path=a size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok
