[statement]
An archive that stops at a header boundary without an end marker. Every
reference reader reads it to that point, and so does ferrotape, unless
metadata waits for a member (see `a-stream-that-ends-after-metadata`).

[archive]
header name=noend
data "hello\n"

[verdict]
all: read

[gnu-tar 1.35]
member listed=- path=noend size=6 mode=0o644 data="hello\n"
exit 0

[bsdtar 3.8.11]
member listed=- path=noend size=6 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=noend size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
member type=0 path=noend size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok
