[statement]
A `SCHILY.acl.access` record bsdtar cannot parse, on a directory of
typeflag `5`. bsdtar reports the record and still lists a directory, as GNU
tar does; ferrotape reads it, passing the record to the caller.

[archive]
pax SCHILY.acl.access=smuggled
header name=d/ typeflag=5
header name=a
data "x"
end

[verdict]
all: read

[gnu-tar 1.35]
member listed=d path=d/ size=0 mode=0o644
member listed=- path=a size=1 mode=0o644 data="x"
exit 0

[bsdtar 3.8.11]
member listed=d path=d/ size=0 mode=0o0
member listed=- path=a size=1 mode=0o644
warning "bsdtar: Parse error: SCHILY.acl.access"
warning "bsdtar: Error exit delayed from previous errors"
exit 1

[python 3.12.3]
member type=5 path=d size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root
member type=0 path=a size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok

[go 1.27.0]
member type=5 path=d/ size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=a size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok
