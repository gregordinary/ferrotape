[statement]
A pax `SCHILY.realsize` record of 100000 on a regular file of 6 bytes.
bsdtar lists the file at 100000 bytes and extracts 100000: the data, then
zeros. GNU tar, Python and Go ignore the record. ferrotape refuses the
archive.

[archive]
pax SCHILY.realsize=100000
header name=f
data "hello\n"
end

[verdict]
all: refused RealSizeRecord at 1024

[gnu-tar 1.35]
member listed=- path=f size=6 mode=0o644 data="hello\n"
warning "tar: Ignoring unknown extended header keyword 'SCHILY.realsize'"
exit 0

[bsdtar 3.8.11]
member listed=- path=f size=100000 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=f size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
member type=0 path=f size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok
