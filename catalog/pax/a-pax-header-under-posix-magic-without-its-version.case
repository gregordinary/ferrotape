[statement]
A pax header whose header has POSIX's magic with NULs for its version. The
four reference readers apply it; the `tar` and `tar-core` crates read it as a
member of its own. Strict refuses it, and Compatible applies it.

[archive]
header name=PaxHeader typeflag=x @263="\0\0"
records path=paxname
header name=short
data "x"
end

[verdict]
strict: refused MetadataWithoutMagic at 0
compatible: read

[gnu-tar 1.35]
member listed=- path=paxname size=1 mode=0o644 data="x"
exit 0

[bsdtar 3.8.11]
member listed=- path=paxname size=1 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=paxname size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok

[go 1.27.0]
member type=0 path=paxname size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok
