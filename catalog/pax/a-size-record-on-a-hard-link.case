[statement]
A pax `size` record on a hard link, its declared body holding a header. GNU
tar and bsdtar read the body as the link's data; Python and Go list the
header in it. ferrotape refuses a hard link declaring a size, however it is
declared.

[archive]
header name=f
data "x"
pax size=512
header name=h typeflag=1 linkname=f
header name=smuggled
header name=tail
data "x"
end

[verdict]
all: refused SizeWithoutData at 2048

[gnu-tar 1.35]
member listed=- path=f size=1 mode=0o644 data="x"
member listed=h path=h link=f size=512 mode=0o644
member listed=- path=tail size=1 mode=0o644 data="x"
exit 0

[bsdtar 3.8.11]
member listed=- path=f size=1 mode=0o644
member listed=- path=h link=f size=512 mode=0o644
member listed=- path=tail size=1 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=f size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
member type=1 path=h link=f size=512 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root
member type=0 path=smuggled size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=tail size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok

[go 1.27.0]
member type=0 path=f size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
member type=1 path=h link=f size=512 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=smuggled size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=tail size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok
