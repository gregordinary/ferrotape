[statement]
A pax `SCHILY.realsize` record of 100000 on a directory. Every reader
ignores it there, bsdtar included, and so does ferrotape.

[archive]
pax SCHILY.realsize=100000
header name=d/ typeflag=5
header name=tail
data "hello\n"
end

[verdict]
all: read

[gnu-tar 1.35]
member listed=d path=d/ size=0 mode=0o644
member listed=- path=tail size=6 mode=0o644 data="hello\n"
warning "tar: Ignoring unknown extended header keyword 'SCHILY.realsize'"
exit 0

[bsdtar 3.8.11]
member listed=d path=d/ size=0 mode=0o644
member listed=- path=tail size=6 mode=0o644
exit 0

[python 3.12.3]
member type=5 path=d size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root
member type=0 path=tail size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
member type=5 path=d/ size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=tail size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok
