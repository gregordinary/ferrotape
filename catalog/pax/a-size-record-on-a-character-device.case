[statement]
A pax `size` record on a character device, its declared body holding a
header. GNU tar reads the body as the device's data; bsdtar, Python and Go
read no data, and list the header in it. ferrotape refuses it at both
levels.

[archive]
pax size=512
header name=c typeflag=3
header name=smuggled
header name=tail
data "x"
end

[verdict]
all: refused SizeWithoutData at 1024

[gnu-tar 1.35]
member listed=c path=c device=0,0 mode=0o644
member listed=- path=tail size=1 mode=0o644 data="x"
exit 0

[bsdtar 3.8.11]
member listed=c path=c device=0,0 mode=0o644
member listed=- path=smuggled size=0 mode=0o644
member listed=- path=tail size=1 mode=0o644
exit 0

[python 3.12.3]
member type=3 path=c size=512 device=0,0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root
member type=0 path=smuggled size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=tail size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok

[go 1.27.0]
member type=3 path=c size=512 device=0,0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=smuggled size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=tail size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok
