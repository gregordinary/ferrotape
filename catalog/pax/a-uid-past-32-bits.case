[statement]
A pax `uid` of 2^32. GNU tar reports it out of range and exits with an
error, and the others read it. ferrotape holds ids as 32-bit numbers and
refuses a larger one.

[archive]
pax uid=4294967296
header name=bigid
data "hello\n"
end

[verdict]
all: refused PaxValue at 0

[gnu-tar 1.35]
member listed=- path=bigid size=6 mode=0o644 data="hello\n"
warning "tar: Extended header uid=4294967296 is out of range 0..4294967295"
warning "tar: Exiting with failure status due to previous errors"
exit 2

[bsdtar 3.8.11]
member listed=- path=bigid size=6 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=bigid size=6 mode=0o644 mtime=0 uid=4294967296 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
member type=0 path=bigid size=6 mode=0o644 mtime=0 uid=4294967296 gid=0 uname=root gname=root data="hello\n"
ok
