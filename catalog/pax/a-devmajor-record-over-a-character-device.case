[statement]
A character device of numbers 1,3 whose pax `SCHILY.devmajor` record says
512. bsdtar takes the numbers from the records, a missing one as 0, and
lists 512,0; GNU tar warns that it does not know the keyword, and it, Python
and Go read 1,3. ferrotape refuses it, at both levels.

[archive]
pax SCHILY.devmajor=512
header name=c typeflag=3 devmajor=1 devminor=3
header name=after
data "y"
end

[verdict]
all: refused DeviceConflict at 1024

[gnu-tar 1.35]
member listed=c path=c device=1,3 mode=0o644
member listed=- path=after size=1 mode=0o644 data="y"
warning "tar: Ignoring unknown extended header keyword 'SCHILY.devmajor'"
exit 0

[bsdtar 3.8.11]
member listed=c path=c device=512,0 mode=0o644
member listed=- path=after size=1 mode=0o644
exit 0

[python 3.12.3]
member type=3 path=c size=0 device=1,3 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root
member type=0 path=after size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="y"
ok

[go 1.27.0]
member type=3 path=c size=0 device=1,3 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=after size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="y"
ok
