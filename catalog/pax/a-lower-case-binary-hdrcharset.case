[statement]
A pax `hdrcharset` of `binary` in lower case, beside a `path` ending in a
slash over a regular file. bsdtar reads it as an unknown value, reporting an
error and listing a regular file, where GNU tar lists a directory. ferrotape
refuses it.

[archive]
pax hdrcharset=binary path=d/
header name=f
header name=a
data "x"
end

[verdict]
all: refused UnknownCharset at 0

[gnu-tar 1.35]
member listed=d path=d/ size=0 mode=0o644
member listed=- path=a size=1 mode=0o644 data="x"
warning "tar: Ignoring unknown extended header keyword 'hdrcharset'"
exit 0

[bsdtar 3.8.11]
member listed=- path=d/ size=0 mode=0o644
member listed=- path=a size=1 mode=0o644
warning "bsdtar: (null)"
warning "bsdtar: Error exit delayed from previous errors"
exit 1

[python 3.12.3]
member type=0 path=d size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=a size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok

[go 1.27.0]
member type=0 path=d/ size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=a size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok
