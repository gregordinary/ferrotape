[statement]
A pax `path` holding a NUL. GNU tar and bsdtar cut the path there, Python
keeps it whole, and Go refuses the archive. ferrotape refuses it.

[archive]
pax path="abc\0def"
header name=short
data "hello\n"
end

[verdict]
all: refused PaxNul at 0

[gnu-tar 1.35]
member listed=- path=abc size=6 mode=0o644 data="hello\n"
exit 0

[bsdtar 3.8.11]
member listed=- path=abc size=6 mode=0o644
exit 0

[python 3.12.3]
member type=0 path="abc\0def" size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
error "archive/tar: invalid tar header"
