[statement]
A pax `gname` record with an empty value, read as an empty `uname` is (see
`an-empty-owner-name`). ferrotape refuses it.

[archive]
pax gname=""
header name=a gname=hdrgroup
data "hello\n"
end

[verdict]
all: refused EmptyPaxValue at 0

[gnu-tar 1.35]
member listed=- path=a size=6 mode=0o644 data="hello\n"
exit 0

[bsdtar 3.8.11]
member listed=- path=a size=6 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=a size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname="" data="hello\n"
ok

[go 1.27.0]
member type=0 path=a size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=hdrgroup data="hello\n"
ok
