[statement]
A pax `size` record of zero on a directory whose header declares a body
holding a header. The record replaces the header's size for every reader, so
none reads data and each lists the header after the directory; ferrotape
reads it.

[archive]
pax size=0
header name=d/ typeflag=5 size=512
header name=smuggled
header name=tail
data "x"
end

[verdict]
all: read

[gnu-tar 1.35]
member listed=d path=d/ size=0 mode=0o644
member listed=- path=smuggled size=0 mode=0o644 data=""
member listed=- path=tail size=1 mode=0o644 data="x"
exit 0

[bsdtar 3.8.11]
member listed=d path=d/ size=0 mode=0o644
member listed=- path=smuggled size=0 mode=0o644
member listed=- path=tail size=1 mode=0o644
exit 0

[python 3.12.3]
member type=5 path=d size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root
member type=0 path=smuggled size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=tail size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok

