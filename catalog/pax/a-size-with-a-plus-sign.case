[statement]
A pax `size` of `+5`. GNU tar reports a malformed header and exits with an
error, bsdtar frames the member's data differently and finds a bad checksum
where it looks for the next header, and Python and Go read 5. ferrotape reads
a size of decimal digits only, and refuses this one.

[archive]
pax size=+5
header name=plus
data "12345"
end

[verdict]
all: refused PaxValue at 0

[gnu-tar 1.35]
member listed=- path=plus size=5 mode=0o644 data="12345"
warning "tar: Malformed extended header: invalid size=+5"
warning "tar: Exiting with failure status due to previous errors"
exit 2

[bsdtar 3.8.11]
member listed=- path=plus size=0 mode=0o644
warning "bsdtar: Damaged tar archive (bad header checksum)"
warning "bsdtar: Retrying..."
exit 0

[python 3.12.3]
member type=0 path=plus size=5 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="12345"
ok

[go 1.27.0]
member type=0 path=plus size=5 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="12345"
ok
