[statement]
A pax header whose size covers a `path` record, then a NUL and a second
`path` record in the padding. Every reader stops at the NUL, and reads
the member as `ab`, as ferrotape does.

[archive]
header name=first
data "1\n"
header name=PaxHeader typeflag=x size=11
data "11 path=ab\n\x0015 path=evil/f\n"
header name=f
header name=after
end

[verdict]
all: read

[gnu-tar 1.35]
member listed=- path=first size=2 mode=0o644 data="1\n"
member listed=- path=ab size=0 mode=0o644 data=""
member listed=- path=after size=0 mode=0o644 data=""
exit 0

[bsdtar 3.8.11]
member listed=- path=first size=2 mode=0o644
member listed=- path=ab size=0 mode=0o644
member listed=- path=after size=0 mode=0o644
exit 0

