[statement]
A pax record whose length runs past its header's data is malformed, and
ferrotape refuses the archive at it.

[archive]
header name=PaxHeader typeflag=x
data "99 path=x\n"
header name=after
data "hello\n"
end

[verdict]
all: refused PaxFraming at 0

[gnu-tar 1.35]
member listed=- path=after size=6 mode=0o644 data="hello\n"
warning "tar: Extended header length 99 is out of range"
warning "tar: Exiting with failure status due to previous errors"
exit 2

[bsdtar 3.8.11]
member listed=- path=after size=6 mode=0o644
warning "bsdtar: Ignoring malformed pax attribute:  99 > 10"
warning "bsdtar: Error exit delayed from previous errors"
exit 1

[python 3.12.3]
error "ReadError: invalid header"

[go 1.27.0]
error "archive/tar: invalid tar header"
