[statement]
A pax `linkpath` record with an empty value. bsdtar and Go take the header's
target, and GNU tar and Python an empty one. ferrotape refuses it.

[archive]
pax linkpath=""
header name=lnk typeflag=2 linkname=hdrtarget
header name=tail
data "hello\n"
end

[verdict]
all: refused EmptyPaxValue at 0

[gnu-tar 1.35]
member listed=l path=lnk link="" size=0 mode=0o644
member listed=- path=tail size=6 mode=0o644 data="hello\n"
exit 0

[bsdtar 3.8.11]
member listed=l path=lnk link=hdrtarget size=0 mode=0o644
member listed=- path=tail size=6 mode=0o644
exit 0

[python 3.12.3]
member type=2 path=lnk size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root
member type=0 path=tail size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
member type=2 path=lnk link=hdrtarget size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=tail size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok
