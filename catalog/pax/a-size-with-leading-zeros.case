[statement]
A pax `size` with leading zeros is read as decimal by every reader.

[archive]
pax size=005
header name=lz
data "12345"
end

[verdict]
all: read

[gnu-tar 1.35]
member listed=- path=lz size=5 mode=0o644 data="12345"
exit 0

[bsdtar 3.8.11]
member listed=- path=lz size=5 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=lz size=5 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="12345"
ok

[go 1.27.0]
member type=0 path=lz size=5 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="12345"
ok
