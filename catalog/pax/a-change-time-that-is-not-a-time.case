[statement]
A pax `ctime` that is not a time, refused as such an `atime` is (see
`an-access-time-that-is-not-a-time`).

[archive]
pax ctime=abc
header name=a
data "hello\n"
end

[verdict]
all: refused PaxValue at 0

[gnu-tar 1.35]
member listed=- path=a size=6 mode=0o644 data="hello\n"
warning "tar: Malformed extended header: invalid ctime=abc"
warning "tar: Exiting with failure status due to previous errors"
exit 2

[bsdtar 3.8.11]
member listed=- path=a size=6 mode=0o644
warning "bsdtar: Ignoring malformed pax ctime"
warning "bsdtar: Error exit delayed from previous errors"
exit 1

[python 3.12.3]
member type=0 path=a size=6 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
error "archive/tar: invalid tar header"
