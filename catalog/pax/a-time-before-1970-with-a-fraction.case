[statement]
A pax time before 1970 with a fraction. bsdtar reads `-1.5` as half a second
before 1970, and GNU tar, Go and Python as one and a half seconds before it.
ferrotape refuses a time before 1970 with a fraction.

[archive]
pax mtime=-1.5
header name=neg-pax-mtime
data "hello\n"
end

[verdict]
all: refused FractionBeforeEpoch at 0

[gnu-tar 1.35]
member listed=- path=neg-pax-mtime size=6 mode=0o644 data="hello\n"
exit 0

[bsdtar 3.8.11]
member listed=- path=neg-pax-mtime size=6 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=neg-pax-mtime size=6 mode=0o644 mtime=-2 uid=0 gid=0 uname=root gname=root data="hello\n"
ok

[go 1.27.0]
member type=0 path=neg-pax-mtime size=6 mode=0o644 mtime=-2 uid=0 gid=0 uname=root gname=root data="hello\n"
ok
