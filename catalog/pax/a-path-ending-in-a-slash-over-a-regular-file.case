[statement]
A pax `path` ending in `/` over a regular member. The path is resolved first,
and its trailing slash makes the member a directory, as it does for a header's
own name (see `a-regular-file-named-with-a-trailing-slash`).

[archive]
pax path=pdir/
header name=pdir
end

[verdict]
all: read

[gnu-tar 1.35]
member listed=d path=pdir/ size=0 mode=0o644
exit 0

[bsdtar 3.8.11]
member listed=d path=pdir/ size=0 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=pdir size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
ok

[go 1.27.0]
member type=0 path=pdir/ size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
ok
