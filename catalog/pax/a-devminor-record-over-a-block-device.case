[statement]
A block device of numbers 8,0 whose pax `SCHILY.devminor` record says 70000.
bsdtar lists 0,70000; GNU tar, Python and Go read 8,0. ferrotape refuses it,
at both levels.

[archive]
pax SCHILY.devminor=70000
header name=b typeflag=4 devmajor=8 devminor=0
header name=after
data "y"
end

[verdict]
all: refused DeviceConflict at 1024

[gnu-tar 1.35]
member listed=b path=b device=8,0 mode=0o644
member listed=- path=after size=1 mode=0o644 data="y"
warning "tar: Ignoring unknown extended header keyword 'SCHILY.devminor'"
exit 0

[bsdtar 3.8.11]
member listed=b path=b device=0,70000 mode=0o644
member listed=- path=after size=1 mode=0o644
exit 0

[python 3.12.3]
member type=4 path=b size=0 device=8,0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root
member type=0 path=after size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="y"
ok

[go 1.27.0]
member type=4 path=b size=0 device=8,0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=after size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="y"
