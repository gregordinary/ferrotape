[statement]
A pax `hdrcharset` of `BINARY`, beside a `path` ending in a slash over a
regular file. GNU tar and bsdtar list a directory, and so does ferrotape.

[archive]
pax hdrcharset=BINARY path=pdir/
header name=pdir
end

[verdict]
all: read

[gnu-tar 1.35]
member listed=d path=pdir/ size=0 mode=0o644
warning "tar: Ignoring unknown extended header keyword 'hdrcharset'"
exit 0

[bsdtar 3.8.11]
member listed=d path=pdir/ size=0 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=pdir size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
ok

[go 1.27.0]
member type=0 path=pdir/ size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
ok
