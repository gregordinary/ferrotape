[statement]
A directory with an access control list and an empty default one, as GNU tar
writes a directory with no default list. Every reader reads it alike, and
ferrotape reads it at both levels.

[archive]
pax SCHILY.acl.access=user::rwx,group::r-x,other::r-x SCHILY.acl.default=""
header name=d/ typeflag=5 mode=0o755
header name=after
data "y"
end

[verdict]
all: read

[gnu-tar 1.35]
member listed=d path=d/ size=0 mode=0o755
member listed=- path=after size=1 mode=0o644 data="y"
exit 0

[bsdtar 3.8.11]
member listed=d path=d/ size=0 mode=0o755
member listed=- path=after size=1 mode=0o644
exit 0

[python 3.12.3]
member type=5 path=d size=0 mode=0o755 mtime=0 uid=0 gid=0 uname=root gname=root
member type=0 path=after size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="y"
ok

[go 1.27.0]
member type=5 path=d/ size=0 mode=0o755 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=after size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="y"
