[statement]
A character device whose major number field is eight spaces. GNU tar
reports blanks where a number belongs and lists major number 4294967295.
bsdtar, Python and Go read 0. ferrotape refuses the archive.

[archive]
header name=f typeflag=3 devmajor="        "
header name=tail
end

[verdict]
all: refused HeaderField at 0

[gnu-tar 1.35]
member listed=c path=f device=4294967295,0 mode=0o644
member listed=- path=tail size=0 mode=0o644 data=""
warning "tar: Blanks in header where numeric major_t value expected"
warning "tar: Exiting with failure status due to previous errors"
exit 2

[bsdtar 3.8.11]
member listed=c path=f device=0,0 mode=0o644
member listed=- path=tail size=0 mode=0o644
exit 0

[python 3.12.3]
member type=3 path=f size=0 device=0,0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root
member type=0 path=tail size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
ok

[go 1.27.0]
member type=3 path=f size=0 device=0,0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=tail size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
ok
