[statement]
A header whose magic is neither POSIX's nor GNU's, its owner name fields
set. Python reads the names, and GNU tar, bsdtar and Go do not, so the
readers own what they extract differently. ferrotape refuses it.

[archive]
header name=a uid=1000 gid=1000 uname=root gname=root @257=xxxxxx
data "x"
end

[verdict]
all: refused UnknownMagic at 0

[gnu-tar 1.35]
member listed=- path=a size=1 mode=0o644 data="x"
exit 0

[bsdtar 3.8.11]
member listed=- path=a size=1 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=a size=1 mode=0o644 mtime=0 uid=1000 gid=1000 uname=root gname=root data="x"
ok

[go 1.27.0]
member type=0 path=a size=1 mode=0o644 mtime=0 uid=1000 gid=1000 uname="" gname="" data="x"
ok
