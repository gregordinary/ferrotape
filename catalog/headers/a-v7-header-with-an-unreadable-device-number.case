[statement]
A v7 header, second in the archive, holding `xx` at its device fields.
Python reads the device fields of every header and ends the archive at one
it cannot read, having listed the member before it; GNU tar, bsdtar and Go
read this member and the one after it. ferrotape refuses it.

[archive]
header name=a
data "x"
header name=b magic=v7 @329="xx"
data "y"
header name=c
data "z"
end

[verdict]
all: refused HeaderField at 1024

[gnu-tar 1.35]
member listed=- path=a size=1 mode=0o644 data="x"
member listed=- path=b size=1 mode=0o644 data="y"
member listed=- path=c size=1 mode=0o644 data="z"
exit 0

[bsdtar 3.8.11]
member listed=- path=a size=1 mode=0o644
member listed=- path=b size=1 mode=0o644
member listed=- path=c size=1 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=a size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok

[go 1.27.0]
member type=0 path=a size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
member type=0 path=b size=1 mode=0o644 mtime=0 uid=0 gid=0 uname="" gname="" data="y"
member type=0 path=c size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="z"
ok
