[statement]
A character device whose minor number field holds octal digits, a space and
more digits, filling the field with no NUL, after another member. GNU tar and
bsdtar read the first digits; Go fails at the header; Python ends the archive
there, having listed the member before it. ferrotape refuses it.

[archive]
header name=lead
data "lead\n"
header name=odd typeflag=3 devminor="00007 01"
header name=tail
data "tail\n"
end

[verdict]
all: refused HeaderField at 1024

[gnu-tar 1.35]
member listed=- path=lead size=5 mode=0o644 data="lead\n"
member listed=c path=odd device=0,7 mode=0o644
member listed=- path=tail size=5 mode=0o644 data="tail\n"
exit 0

[bsdtar 3.8.11]
member listed=- path=lead size=5 mode=0o644
member listed=c path=odd device=0,7 mode=0o644
member listed=- path=tail size=5 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=lead size=5 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="lead\n"
ok

[go 1.27.0]
member type=0 path=lead size=5 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="lead\n"
error "archive/tar: invalid tar header"
