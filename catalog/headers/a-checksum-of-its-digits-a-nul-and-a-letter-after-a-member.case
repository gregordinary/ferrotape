[statement]
A checksum of the sum's six digits, a NUL and a letter, after another
member. GNU tar, Python and Go read the header. bsdtar passes over it as
damaged and lists the member after it alone. ferrotape refuses the
archive.

[archive]
header name=first
data "1\n"
header name=odd checksum="######\x00x"
header name=after
end

[verdict]
all: refused Checksum at 1024

[gnu-tar 1.35]
member listed=- path=first size=2 mode=0o644 data="1\n"
member listed=- path=odd size=0 mode=0o644 data=""
member listed=- path=after size=0 mode=0o644 data=""
exit 0

[bsdtar 3.8.11]
member listed=- path=first size=2 mode=0o644
member listed=- path=after size=0 mode=0o644
warning "bsdtar: Damaged tar archive (bad header checksum)"
warning "bsdtar: Retrying..."
exit 0

[python 3.12.3]
member type=0 path=first size=2 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="1\n"
member type=0 path=odd size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=after size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
ok

[go 1.27.0]
member type=0 path=first size=2 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="1\n"
member type=0 path=odd size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=after size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
ok
