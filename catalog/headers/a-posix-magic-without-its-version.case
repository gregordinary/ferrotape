[statement]
POSIX's magic, `ustar` and a NUL, with NULs for its version, and owner
names. Every reader reads POSIX's magic whatever its version, and reads the
names; so does ferrotape.

[archive]
header name=a uid=1000 gid=1000 uname=root gname=root @263="\0\0"
data "x"
end

[verdict]
all: read

[gnu-tar 1.35]
member listed=- path=a size=1 mode=0o644 data="x"
exit 0

[bsdtar 3.8.11]
member listed=- path=a size=1 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=a size=1 mode=0o644 mtime=0 uid=1000 gid=1000 uname=root gname=root data="x"
ok

[go 1.27.0]
member type=0 path=a size=1 mode=0o644 mtime=0 uid=1000 gid=1000 uname=root gname=root data="x"
ok
