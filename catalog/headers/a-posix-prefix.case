[statement]
A POSIX header's prefix is joined to its name with a `/`: every reader names
this member `pre/fix/name`.

[archive]
header name=name prefix=pre/fix
data "p\n"
end

[verdict]
all: read

[gnu-tar 1.35]
member listed=- path=pre/fix/name size=2 mode=0o644 data="p\n"
exit 0

[bsdtar 3.8.11]
member listed=- path=pre/fix/name size=2 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=pre/fix/name size=2 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="p\n"
ok

[go 1.27.0]
member type=0 path=pre/fix/name size=2 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="p\n"
ok
