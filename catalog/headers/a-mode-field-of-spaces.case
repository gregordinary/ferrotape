[statement]
A mode field of eight spaces. GNU tar reports blanks where a number belongs,
lists mode 7777 and exits with an error. bsdtar, Python and Go read mode 0.
ferrotape refuses the archive.

[archive]
header name=f mode="        "
header name=tail
end

[verdict]
all: refused HeaderField at 0

[gnu-tar 1.35]
member listed=- path=f size=0 mode=0o7777 data=""
member listed=- path=tail size=0 mode=0o644 data=""
warning "tar: Blanks in header where numeric mode_t value expected"
warning "tar: Exiting with failure status due to previous errors"
exit 2

[bsdtar 3.8.11]
member listed=- path=f size=0 mode=0o0
member listed=- path=tail size=0 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=f size=0 mode=0o0 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=tail size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
ok

[go 1.27.0]
member type=0 path=f size=0 mode=0o0 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=tail size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
ok
