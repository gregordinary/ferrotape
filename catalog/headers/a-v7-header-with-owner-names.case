[statement]
A v7 header, with no magic, holding bytes where a POSIX header keeps its
owner names. Python reads them as the owner's names; Go reads none. ferrotape
refuses it.

[archive]
header name=a magic=v7 @265="root" @297="root"
data "x"
end

[verdict]
all: refused UnknownMagic at 0

[gnu-tar 1.35]
member listed=- path=a size=1 mode=0o644 data="x"
exit 0

[bsdtar 3.8.11]
member listed=- path=a size=1 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=a size=1 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="x"
ok

[go 1.27.0]
member type=0 path=a size=1 mode=0o644 mtime=0 uid=0 gid=0 uname="" gname="" data="x"
ok
