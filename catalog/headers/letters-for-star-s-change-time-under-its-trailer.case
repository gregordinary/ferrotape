[statement]
A POSIX header ending in star's trailer, `tar` and a NUL, with a prefix
of three bytes, star's access time, and letters where star keeps its
change time, after another member. Go reads the header in star's format
and fails at it. GNU tar, bsdtar and Python ignore star's times.
ferrotape refuses the archive.

[archive]
header name=first
data "1\n"
header name=file prefix=dir @476="00000001750\x00xxxxxxxxxxx\x00" @508="tar\x00"
header name=after
end

[verdict]
all: refused HeaderField at 1024

[gnu-tar 1.35]
member listed=- path=first size=2 mode=0o644 data="1\n"
member listed=- path=dir/file size=0 mode=0o644 data=""
member listed=- path=after size=0 mode=0o644 data=""
exit 0

[bsdtar 3.8.11]
member listed=- path=first size=2 mode=0o644
member listed=- path=dir/file size=0 mode=0o644
member listed=- path=after size=0 mode=0o644
exit 0

[python 3.12.3]
member type=0 path=first size=2 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="1\n"
member type=0 path=dir/file size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
member type=0 path=after size=0 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data=""
ok

[go 1.27.0]
member type=0 path=first size=2 mode=0o644 mtime=0 uid=0 gid=0 uname=root gname=root data="1\n"
error "archive/tar: invalid tar header"
